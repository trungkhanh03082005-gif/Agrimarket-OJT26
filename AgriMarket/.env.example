# ==========================================
# AgriMarket - Backend Environment Template
# ==========================================

# DATABASE (PostgreSQL)
DB_URL=jdbc:postgresql://<HOST>:5432/<DATABASE>
DB_USER=postgres
DB_PASSWORD=your_database_password

# EMAIL - Brevo SMTP
GMAIL_USERNAME=your_brevo_smtp_login
GMAIL_PASSWORD=your_brevo_smtp_key

# GEMINI AI
GEMINI_API_KEY=your_gemini_api_key

# AGORA VIDEO CALL
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# GHN SHIPPING (Giao Hàng Nhanh)
GHN_API_TOKEN=your_ghn_token
GHN_API_SHOPID=your_shop_id
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/create
GHN_SIMULATION_ENABLED=true

# VNPAY
VNP_RETURN_URL=http://localhost:3000/payment/vnpay-callback
